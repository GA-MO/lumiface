BOOTSTRAP_API_KEY=change-me
BOOTSTRAP_PRESET=balanced
ADMIN_API_KEY=
DEBUG=0
STORE_FRAMES=0
MATCH_THRESHOLD=0.45
SPOOF_THRESHOLD=0.50
SPOOF_HARD_FLOOR=0.30
CHALLENGE_POOL=blink,turn_left,turn_right,smile,nod
REQUIRED_CHALLENGE=smile
FLASH_COUNT=3
FLASH_ENFORCE=1
SMILE_ENFORCE=1
# Retention: default expiry of enrolled faces (0 = keep until DELETE), purge loop period (0 = off),
# how long spent sessions stay before purge
SUBJECT_TTL_SECONDS=0
RETENTION_INTERVAL_SECONDS=300
SESSION_PURGE_GRACE_SECONDS=3600
# Life of a device enrol token from POST /v1/subjects/tokens
ENROL_TOKEN_TTL_SECONDS=300
# Upload caps: whole body, one frame, decoded pixels
MAX_UPLOAD_BYTES=33554432
MAX_FRAME_BYTES=4194304
MAX_IMAGE_PIXELS=20000000
