{
  "name": "lumiface-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/lumiface-react",
    "website"
  ],
  "scripts": {
    "dev:site": "bun run --cwd website dev",
    "build:site": "bun run --cwd website build",
    "build:pages": "bun run --cwd website build:static",
    "dev:react": "bun run --cwd packages/lumiface-react dev",
    "test:react": "bun run --cwd packages/lumiface-react test",
    "typecheck": "bun run --cwd packages/lumiface-react typecheck && bun run --cwd website typecheck"
  }
}
